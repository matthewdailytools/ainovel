# 将本文件复制为 .env 后填写；.env 不会提交到 Git。
# 环境变量优先于本文件。无需给密钥添加 Bearer 前缀。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 工作台支持 none/low/high/max；none 保留原非思考模式。连接测试仍使用其固定测试设置。
DEEPSEEK_REASONING_EFFORT=none

# 此处填写 OpenAI API Key。
OPENAI_API_KEY=
# 第二组 OpenAI Key；与第一组共用 20 美元上限，不填写时账户显示未配置。
OPENAI_API_KEY_2=
OPENAI_MODEL=gpt-6-luna
# 该默认模型支持 none；更换模型时按其能力修改，留空可省略 reasoning 参数。
OPENAI_REASONING_EFFORT=none
OPENAI_BASE_URL=https://api.openai.com/v1

# 每家服务的完整请求时限（毫秒，1000–120000）。
API_TEST_TIMEOUT_MS=30000
# 输出 token 上限（16–4096）；默认模型使用非思考模式做简短连接测试。
API_TEST_MAX_OUTPUT_TOKENS=64
