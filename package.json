{
  "name": "ainovel-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:legacy": "node --test tests/api-test.test.mjs tests/product-review.test.mjs",
    "generate:api": "node scripts/generate-api-types.mjs",
    "format:check": "prettier --check frontend vite.config.ts vitest.config.ts scripts/generate-api-types.mjs package.json tsconfig.json fixtures"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
